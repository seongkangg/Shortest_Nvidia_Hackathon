# App URLs (for OAuth redirects and frontend)
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# NVIDIA Nemotron (nvidia/nvidia-nemotron-nano-9b-v2)
# OpenAI-compatible endpoint, e.g. NVIDIA NIM
NVIDIA_NEMOTRON_ENDPOINT=
NVIDIA_NEMOTRON_API_KEY=

# GitHub OAuth (create app at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth (optional; can paste profile instead)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Database (SQLite)
DATABASE_PATH=resumes.db
